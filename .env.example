# Public app identifier, never a secret
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Server-only live Graph source. Use a Uniswap v3 schema deployment.
GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Public testnet contracts. Set after deployment.
NEXT_PUBLIC_EXIT_EXECUTOR_ADDRESS=
NEXT_PUBLIC_TEST_TOKEN_ADDRESS=
# Used only by local deployment scripts; never expose to the browser.
DEPLOYER_PRIVATE_KEY=
# A Privy authorization key for policy setup, if configured.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
